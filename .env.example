# Primary LLM lane (Groq - free key at https://console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
# Generation lane model
LLM_MODEL=openai/gpt-oss-120b
# Fast lane for routing/summarisation calls (separate free quota pool)
LLM_FAST_MODEL=openai/gpt-oss-20b

# Fallback lane: used automatically on HTTP 429/5xx/connection errors
ENABLE_LLM_FALLBACK=1
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_LLM_API_KEY=your-google-ai-studio-key
FALLBACK_LLM_MODEL=gemini-2.5-flash

# Redis
REDIS_URL=redis://localhost:6379

# Embeddings (local fastembed, no key required)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Step 7: semantic routing
ENABLE_ROUTING=1
ENABLE_ACTIONS=1
ENABLE_DESTRUCTIVE_ACTIONS=1

# Step 8: multi-tenancy (X-Tenant-Id header required on every endpoint except /health)
# "*" accepts any valid slug; or restrict: TENANTS=acme,globex
TENANTS=*

# Step 9: document versioning (auto content-hash tracking + stale warnings)
ENABLE_DOC_VERSIONING=1
ENABLE_DRIFT_WARNING=1
DRIFT_SCAN_TTL_S=30

# Step 10: MCP server mounted at /mcp (streamable HTTP) for AI agent clients
ENABLE_MCP=1
# Fallback tenant when an MCP client sends no X-Tenant-Id header
MCP_DEFAULT_TENANT=
# Optional shared secret; when set, /mcp requires Authorization: Bearer <token>
MCP_BEARER_TOKEN=
# Hostname allowlist for DNS-rebinding protection when deployed behind a real host
MCP_ALLOWED_HOSTS=

# Step 12: multi-model strategy
# Economy lane: cheap model for chitchat/memory synthesis + semantic-cache
# warming (stored/background content). Auto-falls over to the Groq model
# below when Gemini returns 429/5xx; doc answers always use LLM_MODEL.
LLM_ECONOMY_MODEL=gemini-2.5-flash-lite
LLM_ECONOMY_FALLBACK_MODEL=llama-3.1-8b-instant
# Cache warming: background job regenerating popular questions with the
# economy lane into the semantic cache.
ENABLE_CACHE_WARM=1
CACHE_WARM_TOP_N=10

# Step 11: real-time events (per-tenant Redis Streams -> SSE /events/stream)
ENABLE_EVENTS=1
# Ring-buffer size per tenant stream (exact trim on each publish)
EVENTS_STREAM_MAXLEN=1000
# Seconds between SSE heartbeat comments (also bounds the blocking XREAD)
EVENTS_HEARTBEAT_S=15
# Browser origins allowed to subscribe cross-origin ("*" dev / comma list / empty=off)
EVENTS_CORS_ORIGINS=*